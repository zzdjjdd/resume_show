# ===== RAG 本地知识库 - 环境变量模板 =====
# 复制为 .env 再填入自己的 Key:
#     cp .env.example .env      # Git Bash / macOS / Linux
#     copy .env.example .env    # Windows CMD
# .env 已被 .gitignore 忽略,切勿提交真实密钥。

# 1) 嵌入模型:硅基流动 Qwen3-Embedding-4B
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# 2) 对话模型:MiniMax-M3 (OpenAI 兼容协议)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3

# 3) 服务配置
HOST=127.0.0.1
PORT=8000
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
DATA_DIR=./data
# FAISS 在含中文/非 ASCII 的路径下 fopen 可能失败,保持纯 ASCII 路径最稳
INDEX_DIR=./storage
