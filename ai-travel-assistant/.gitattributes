# Normalize line endings: LF inside the repository, native on checkout.
* text=auto

# Shell scripts must keep LF or they break on Linux/macOS.
*.sh   text eol=lf

# Windows batch files must keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets - never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.index binary
