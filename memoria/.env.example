# Memoria - local environment template
#
# Copy to `.env` and fill in your own keys:
#     cp .env.example .env          # Git Bash / macOS / Linux
#     copy .env.example .env        # Windows CMD
#
# `.env` is gitignored. NEVER commit real credentials.
# On Windows you can alternatively keep using `secrets.bat` (also gitignored);
# start.bat calls it automatically if present.

# ---------- Embedding backend ----------
# MEMORIA_EMBEDDER: fake (offline default) | local | openai
# "openai" also works for any OpenAI-compatible endpoint (DashScope, SiliconFlow, ...).
MEMORIA_EMBEDDER=openai
MEMORIA_EMBEDDER_MODEL=text-embedding-v3
MEMORIA_EMBEDDER_DIMENSIONS=1024
EMBEDDER_API_KEY=
EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- LLM backend ----------
# MEMORIA_LLM: (unset for none) | deepseek | openai | openai-compat
MEMORIA_LLM=deepseek
MEMORIA_LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# ---------- Storage (optional; defaults are in-process and non-durable) ----------
# Point both at durable backends together, or memory is lost on restart.
# MEMORIA_SQLITE_URL=sqlite:///./memoria.db
# MEMORIA_VECTOR_STORE=chroma
# MEMORIA_CHROMA_PATH=./.chroma
# MEMORIA_NAMESPACE=web-demo

# ---------- Tools via MCP (optional) ----------
# Hosted AMap (Gaode) MCP endpoint - geocoding, POI search, routing, weather.
AMAP_MAPS_API_KEY=
# MEMORIA_AMAP_MCP_URL=https://mcp.amap.com/v1/sse
